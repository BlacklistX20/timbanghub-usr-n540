# =========================================================
# Konfigurasi Sistem Monitoring Timbangan - Gudang Pupuk
# =========================================================

# ---------------------------------------------------------
# Database Lokal (MySQL)
# ---------------------------------------------------------
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=gudang_pupuk
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=

# ---------------------------------------------------------
# Database Online (MySQL)
# ---------------------------------------------------------
DB_ONLINE_HOST=
DB_ONLINE_PORT=3306
DB_ONLINE_NAME=gudang_pupuk
DB_ONLINE_USER=
DB_ONLINE_PASSWORD=

# ---------------------------------------------------------
# Sinkronisasi Lokal -> Online
# ---------------------------------------------------------
# Jeda antar siklus sinkronisasi (cek data belum tersinkron
# lalu kirim ke DB online), dalam milidetik
SYNC_INTERVAL_MS=5000

# Maksimal jumlah baris (scale_readings / scale_status_logs)
# yang dikirim per siklus sinkronisasi. Berguna buat batasi
# ukuran query pas ada banyak data menumpuk (mis. abis lama
# offline).
SYNC_BATCH_SIZE=100

# ---------------------------------------------------------
# Polling Pembacaan Timbangan (worker Modbus)
# ---------------------------------------------------------
# Jeda antar pembacaan berat per timbangan, dalam milidetik.
# Sama untuk semua timbangan (global).
POLL_INTERVAL_MS=200

# Timeout baca Modbus per request, dalam milidetik. Sebaiknya
# lebih kecil dari POLL_INTERVAL_MS supaya tidak menumpuk.
MODBUS_TIMEOUT_MS=100

# Batas bawah & atas berat (kg) yang dianggap valid, sama untuk
# semua timbangan. Pembacaan di luar rentang ini TIDAK disimpan
# ke scale_readings (dianggap anomali/noise sensor), tapi status
# koneksi timbangan tetap dianggap 'connected' karena pembacaan
# Modbus-nya sendiri berhasil.
WEIGHT_MIN_KG=40
WEIGHT_MAX_KG=55

# ---------------------------------------------------------
# Polling Pembacaan Timbangan
# ---------------------------------------------------------
# Jeda antar pembacaan Modbus (readInputRegisters) untuk SEMUA
# timbangan, dalam milidetik. Sama untuk semua timbangan (global).
POLL_INTERVAL_MS=1000

# =========================================================
# Konfigurasi per Timbangan
# Setiap timbangan punya blok sendiri (self-contained) agar
# mudah diubah tanpa menyentuh worker/kode.
#
# Keterangan field:
#   SCALE_x_DB_ID          -> harus sama dengan id di tabel `scales`
#   SCALE_x_CODE           -> harus sama dengan code di tabel `scales`
#   SCALE_x_HOST           -> IP USR-N540 (bisa sama untuk semua
#                              karena 1 device dgn 4 port, tapi
#                              tetap dipisah per timbangan untuk
#                              fleksibilitas ke depan)
#   SCALE_x_TCP_PORT       -> port TCP gateway Modbus RTU di
#                              USR-N540 untuk port RS485 tsb
#                              (WAJIB beda tiap timbangan)
#   SCALE_x_UNIT_ID        -> Modbus slave/unit ID indikator
#                              timbangan (cek dokumen alat)
#   SCALE_x_REGISTER_ADDRESS -> alamat register untuk
#                              readInputRegisters (cek dokumen
#                              protokol indikator timbangan)
#   SCALE_x_REGISTER_LENGTH  -> jumlah register yang dibaca
#                              (1 = 16-bit, 2 = 32-bit gabungan
#                              2 register - sesuaikan dgn alat)
# =========================================================

# ---------------------------------------------------------
# Timbangan 1 (TIMBANGAN-01)
# ---------------------------------------------------------
SCALE_1_DB_ID=1
SCALE_1_CODE=TIMBANGAN-01
SCALE_1_HOST=192.168.0.7
SCALE_1_TCP_PORT=502
SCALE_1_UNIT_ID=1
SCALE_1_REGISTER_ADDRESS=4
SCALE_1_REGISTER_LENGTH=1

# ---------------------------------------------------------
# Timbangan 2 (TIMBANGAN-02)
# ---------------------------------------------------------
SCALE_2_DB_ID=2
SCALE_2_CODE=TIMBANGAN-02
SCALE_2_HOST=192.168.0.7
SCALE_2_TCP_PORT=503
SCALE_2_UNIT_ID=2
SCALE_2_REGISTER_ADDRESS=4
SCALE_2_REGISTER_LENGTH=1

# ---------------------------------------------------------
# Timbangan 3 (TIMBANGAN-03)
# ---------------------------------------------------------
SCALE_3_DB_ID=3
SCALE_3_CODE=TIMBANGAN-03
SCALE_3_HOST=192.168.0.7
SCALE_3_TCP_PORT=505
SCALE_3_UNIT_ID=3
SCALE_3_REGISTER_ADDRESS=4
SCALE_3_REGISTER_LENGTH=1

# ---------------------------------------------------------
# Timbangan 4 (TIMBANGAN-04)
# ---------------------------------------------------------
SCALE_4_DB_ID=4
SCALE_4_CODE=TIMBANGAN-04
SCALE_4_HOST=192.168.0.7
SCALE_4_TCP_PORT=504
SCALE_4_UNIT_ID=4
SCALE_4_REGISTER_ADDRESS=4
SCALE_4_REGISTER_LENGTH=1
